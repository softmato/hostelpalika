# Strangler routing (ARCHITECTURE.md §11): ported paths go to Go, everything
# else to the TS server. Porting a group = add its path to @go; rollback =
# remove it and `caddy reload`.

{$API_HOST} {
	encode zstd gzip

	# Refused here before it costs the API anything; the API's own limits
	# (httpx.BodyLimit) are the real ones and are per content type.
	request_body {
		max_size 13MB
	}

	# GO_PATHS widens the Go side without editing this file (Phase 10 scale check:
	# GO_PATHS="/api/*"); cut-over sets it the same way.
	@go path {$GO_PATHS:/api/v1/health}
	handle @go {
		reverse_proxy {
			# Every replica of the api service (`--scale api=N`), looked up again
			# each refresh: no sticky sessions, any instance serves any request.
			dynamic a api 8080 {
				refresh 5s
			}
			lb_policy round_robin
			# A replica that is shutting down refuses new connections; the request
			# goes to another one instead of failing (SIGTERM under load, Phase 10).
			lb_try_duration 5s
			fail_duration 10s
			header_up X-Request-Id {http.request.uuid}
		}
	}

	handle {
		reverse_proxy {$TS_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}
}

# The Go server's own env (ENVIRONMENT.md §2). Never copy the root .env here:
# it holds the production Atlas URI.
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug
API_ADDR=127.0.0.1:8080

# Host runs (`go run ./cmd/api`) talk to the compose.local.yaml containers.
# Inside compose these two are overridden to the container names.
MONGODB_URI=mongodb://127.0.0.1:27018/hostelpalika_dev?directConnection=true
REDIS_URL=redis://127.0.0.1:6380/0

JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-at-least-32-characters-long
CRON_SECRET=
SCHEDULER_ENABLED=false
CORS_ORIGINS=http://localhost:3000

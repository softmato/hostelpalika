# =============================================================
# Multi-Hostel SaaS Platform — environment template
# Copy to .env at the repo root and fill in real values.
# Never commit .env (only this .env.example is tracked).
# See docs/ENVIRONMENT.md for full documentation.
# =============================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (MongoDB Atlas or local MongoDB) ---
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority"

# --- Auth / JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- OTP (legacy signup flow) ---
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5
OTP_HASH_SECRET=replace-with-a-random-string

# --- Google OAuth (login) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Google Maps Platform (optional — runtime fallback, Phase 2) ---
# Leave blank to use OpenStreetMap only (free).
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# --- Cloudflare R2 (S3-compatible file storage) ---
# TWO buckets, split by whether the object is world-readable. This is a security
# boundary, not organisation: a presigned URL carries the object key in its path,
# so if private objects sat in a bucket with public access enabled, anyone ever
# shown a signed link could strip the signature and re-fetch it unsigned, for
# ever. The private bucket must have NO public access and NO custom domain.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Public access ENABLED. Hostel gallery photos, registration documents.
R2_BUCKET_PUBLIC=your-public-bucket
# Public access DISABLED. Payment proofs, identity documents, statements.
R2_BUCKET_PRIVATE=your-private-bucket

# Folder this project owns inside the buckets, for when they are shared with
# other projects on the same account. Leave blank for a bucket of your own.
R2_KEY_PREFIX=hostelproject

# Public base URL of R2_BUCKET_PUBLIC and nothing else. Pointing this at the
# private bucket would undo the split above.
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Browser origins allowed to upload straight to R2 with a presigned URL, comma
# separated. R2 answers the upload's preflight itself, so the list has to be set
# on the buckets: `node scripts/r2-cors.mjs --apply` reads this and writes it.
# Without it every browser upload dies with "No 'Access-Control-Allow-Origin'".
# One `*` per entry is allowed, which is how preview deploys are covered: they get
# a fresh hostname every build, all prefixed with the Vercel project name.
R2_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app,https://your-app-*.vercel.app

# Scope the API token to just these two buckets with Object Read & Write —
# not an account-wide token, which would let this app reach every other
# project's storage on the same account.

# --- Email (Resend) ---
# Two variables, and only two. Everything else about the sender — display name,
# reply-to, and the local-part used per category — belongs to the platform
# owner and is edited under Website Config → Site Content → Email Sending.
# See docs/EMAIL_SYSTEM.md §0.
RESEND_API_KEY=re_your_resend_api_key
#
# The verified sending domain. Mail goes out as <mailbox>@EMAIL_DOMAIN, where
# the mailbox is chosen by what the message is:
#   info@      ordinary product mail — notices, approvals, invitations
#   alert@     needs attention now — SOS, overdue fees, a gateway that is down
#   billing@   invoices, receipts, reminders, refunds
#   security@  OTPs, password resets, credentials, account deletion
#   support@   mail a person will reply to — inquiries, complaint threads
#   noreply@   machine mail with nothing to say back to
#
# Verifying the DOMAIN in Resend covers every local-part on it, so none of these
# need setting up individually to SEND. Receiving is separate: a reply only
# reaches a human if that address also exists as an ImprovMX forwarding alias.
# An unverified domain here does not degrade — every email bounces.
EMAIL_DOMAIN=yourdomain.com
# Optional. Overrides the reply address configured in the admin UI.
EMAIL_REPLY_TO=

# --- Seed / bootstrap (SUPERADMIN — created only by the seed script) ---
SEED_SUPERADMIN_EMAIL=admin@yourdomain.com
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_PASSWORD=set-a-strong-one-time-password

# --- Cron secret (protects all twelve /api/v1/cron/* endpoints; scheduled via cron-job.org — see docs/CRON.md) ---
CRON_SECRET=replace-with-a-long-random-secret

# Signs the resident QR activation codes. Falls back to CRON_SECRET when unset,
# which is why activation kept working without it — set it separately so
# rotating the cron secret does not invalidate every unredeemed activation code.
ACTIVATION_CODE_SECRET=

# --- Realtime (Pusher Channels) ---
# All four together, or none. With any of them missing the realtime layer
# no-ops SILENTLY and every portal falls back to polling — live panels and the
# notification bell still work, they just update late. Nothing logs an error,
# so an accidental omission here looks like "the app feels slow", not a fault.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# --- Browser push notifications (Web Push / VAPID) ---
# What makes a notification arrive on a laptop with the tab closed. The phone
# app is pushed through Expo and needs nothing here; the browser is pushed
# through the Web Push protocol, which is signed with a VAPID key pair.
#
# Generate one pair, once, and keep it: the public key is baked into every
# browser subscription that has already been created, so rotating it silently
# invalidates all of them and every subscribed browser goes quiet until it
# re-subscribes. Run `npm run web:generate:vapid` and paste the output.
#
# All three together, or none. With any of them missing browser push no-ops —
# the bell, the socket and the phone app all keep working, so the only symptom
# is that laptops stop buzzing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contactable identity for the push service to reach if we misbehave. Must be a
# `mailto:` or `https:` URL — the push services reject anything else.
VAPID_SUBJECT=mailto:support@softmato.com

# --- Seed / bootstrap (PLATFORM_OWNER — created only by the seed script) ---
SEED_PLATFORM_OWNER_EMAIL=
SEED_PLATFORM_OWNER_NAME=
SEED_PLATFORM_OWNER_PASSWORD=

# --- Upload limits and allowlists (optional) ---
# Leave blank to use the defaults in packages/shared/src/utils/file-assets.ts.
# Set one only to override it; the value replaces the default rather than
# extending it, so a partial ALLOWED_*_MIME_TYPES list NARROWS what uploads.
UPLOAD_MAX_IMAGE_BYTES=
UPLOAD_MAX_DOCUMENT_BYTES=
UPLOAD_MAX_VIDEO_BYTES=
ALLOWED_IMAGE_MIME_TYPES=
ALLOWED_DOCUMENT_MIME_TYPES=
ALLOWED_VIDEO_MIME_TYPES=

# --- Public form rate limiting (optional; defaults 10 requests / 60s) ---
PUBLIC_FORM_RATE_LIMIT_MAX=
PUBLIC_FORM_RATE_LIMIT_WINDOW_SECONDS=

# --- UI preview (NEVER set this in production) ---
# `true` skips the portal route guard so a designer can click through
# /platform, /hostel-admin, /{slug}/admin, /resident and /guardian without an
# account for each role. It is IGNORED when NODE_ENV=production — see
# apps/web/src/lib/auth-bypass.ts — but leave it unset in production anyway.
NEXT_PUBLIC_UI_PREVIEW=

# --- Free-tier LLM router (public hero search fallback) ---
# Optional. With none of these set, hero search stays keyword-only — it never
# errors, it just stops handling freeform sentences. Each var takes a
# COMMA-SEPARATED list of keys; they are tried in order and a key that reports a
# quota error is parked until the next UTC midnight.
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
MISTRAL_API_KEYS=
CEREBRAS_API_KEYS=
# Optional provider preference order (default: gemini,groq,openrouter,mistral,cerebras)
LLM_PROVIDER_ORDER=
# Signs the per-visitor search quota cookie (10 LLM calls / 5 hours).
# Falls back to CRON_SECRET when unset.
SEARCH_QUOTA_SECRET=

# --- Logging ---
# No COOKIE_DOMAIN / COOKIE_SECURE: they were listed here but read by nothing.
# Session cookies are host-only and are marked `secure` whenever
# NODE_ENV=production, which needs no configuration.
LOG_LEVEL=info

# --- Push notifications (Phase 6) ---
# No Firebase variables are needed. Push goes through the Expo push service,
# which accepts both Expo and raw FCM tokens, so the FIREBASE_PROJECT_ID /
# FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY trio that used to sit here was
# read by nothing and has been removed. See TODO.md Track C.
# --- Resident identity profiles (AES-256-GCM at rest) ---
# Encrypts the fill-once personal profile behind a user's resident ID.
# Generate with: openssl rand -base64 32
# Rotating this key makes every stored resident profile permanently unreadable.
PERSONAL_DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# --- Finance gateway secrets (Tier 1, plan item 6.0) ---
# Wraps the per-secret data keys in `EncryptedSecret` (ADR-6). Required once any
# hostel enables a payment gateway. Generate with: openssl rand -base64 32
# A value shorter than 32 bytes is REJECTED, not stretched — see docs/ENVIRONMENT.md.
FINANCE_MASTER_KEY=replace-with-openssl-rand-base64-32
# Set only while rotating. Both keys are accepted until `npm run web:rotate:finance-key`
# reports zero rows remaining on the old one; then remove this.
FINANCE_MASTER_KEY_PREVIOUS=

# Set to `off` to disable the OCR pass over payment evidence. Anything else (or
# unset) leaves it on. Off means claims simply carry no evidence flags — they
# are never rejected for it — so `Approve all` behaves as it did before OCR.
EVIDENCE_OCR=

# --- iOS universal links ---
# `<Apple Team ID>.com.softmato.hostelpalika` — Apple Developer → Membership.
#
# The only thing standing between the app and iOS universal links. It is served
# at /.well-known/apple-app-site-association, Apple's counterpart to the
# committed assetlinks.json beside it; unset, that path answers 404 and a tapped
# https link opens Safari, which is today's behaviour. Setting it takes effect
# on the next deploy — no app rebuild, no release.
#
# Not committed with a placeholder on purpose: iOS caches what it fetches, so a
# file naming the wrong app outlives the deploy that corrects it and fails
# silently. See the route handler for the full reasoning.
APPLE_APP_ID_PREFIX=

# --- Reading the receipt (evidence pipeline) ---
# Which engine reads uploaded receipts: `vision+gemini`, `vision`, `gemini`,
# `tesseract`, or `shadow`.
#
# LEAVE THIS UNSET IN PRODUCTION. Unset resolves to the best combination that is
# actually credentialled: `vision+gemini` when both GCP_VISION_SA_KEY and
# GEMINI_API_KEYS are set, else `vision`, else `gemini`, else `tesseract`. A
# deployment that adds a credential and forgets this line gets the working
# engine rather than silently keeping the broken one.
#
# `vision+gemini` reads with Vision and falls through to Gemini ONLY when Vision
# did not answer at all — no credential, vendor error, timeout, or the monthly
# breaker. A blank page is not a fall-through: Vision ran and the file has no
# text on it, and asking a language model to look again at a page known to be
# blank invites it to find something there. The second read is only paid for on
# the reads the first one failed, so the steady-state cost is one read.
#
# Set `vision` explicitly ONLY to measure Vision alone — the scoring harness
# does exactly this, and a `vision` that quietly answered with Gemini would
# report Gemini's score as Vision's.
#
# `gemini` exists because Cloud Vision requires a billing account and a billing
# account requires a payment card. Gemini's free tier requires neither, and it
# reuses GEMINI_API_KEYS from the LLM router section above — so there is nothing
# to procure. It transcribes the page and nothing more: every judgement about
# what the text means stays in the deterministic parsers, which is what keeps a
# sentence painted onto a screenshot from becoming an instruction. It reports no
# word boxes, so phase 3 spatial parsing still waits for Vision.
#
# `tesseract` DOES NOT RUN IN THE VERCEL LAMBDA. It resolves a worker, six WASM
# cores and a 5 MB model out of node_modules at runtime and no bundler traces
# them. Locally it is fine. In production it is a placeholder, not a fallback.
#
# `shadow` runs both, lets Tesseract drive behaviour, and logs every file where
# the two would fill the claim form in differently. That is the rollout lever:
# nothing a resident or warden sees changes, and the divergences are the
# real-world evidence for the cutover.
#
# There is deliberately NO fallback from any engine to tesseract. A fuzzy read
# standing in for a failed one produces a false green light on a claim, which is
# strictly worse than no signal — no signal puts a human in front of the image.
# Vision falling through to Gemini is not that: Gemini scores 68% all-critical
# on the real corpus against Tesseract's 16%, so it is a second opinion rather
# than a guess. When both fail the answer is still nothing, and nothing is still
# a human looking at the image.
EVIDENCE_ENGINE=

# Google Cloud Vision service account, as one line of JSON — the whole file that
# the console downloads. Server-side only; it is never reachable from the app.
# Escaped newlines inside private_key are expected and handled.
#
# The project needs the Cloud Vision API enabled and billing attached (the free
# tier still requires a billing account). The service account needs the
# `Service Usage Consumer` role and nothing more.
#
# USE A GOOGLE CLOUD PROJECT OF ITS OWN — not the one that issued the AI Studio
# key in GEMINI_API_KEYS. Attaching billing to that project can move Gemini off
# its free tier and onto paid, which would quietly put a bill on the fallback
# engine that exists precisely because it is free.
#
# In a .env file this value must be SINGLE-quoted. Double quotes make dotenv
# expand the 
 escapes inside private_key into real newlines, and JSON.parse
# then fails on a control character with an error that explains nothing.
GCP_VISION_SA_KEY=

# Overrides for the Gemini engine. A 15s ceiling (a single read lands near 2.2s)
# and 5000 reads a month as a runaway guard rather than a budget. Set the cap to
# 0 to switch the breaker off entirely, which also keeps the scoring harness out
# of Mongo.
#
# EVIDENCE_GEMINI_MODEL is a COMMA-SEPARATED LIST, tried in order until one
# answers. That is not a nicety: the free tier is metered per model per day and
# the allowances are small — gemini-2.5-flash permits twenty requests a day —
# so several small allowances have to be walked to make one usable one. Default
# is `gemini-3.1-flash-lite,gemini-2.5-flash`; only add names verified to work,
# because Google gates some newer models behind a different API and they answer
# HTTP 400 to every request.
#
# Adding a second GEMINI_API_KEYS entry from a DIFFERENT Google project is the
# other lever: the daily quota is per project, so a second key doubles it.
EVIDENCE_GEMINI_MODEL=
EVIDENCE_GEMINI_TIMEOUT_MS=
EVIDENCE_GEMINI_MONTHLY_CAP=

# `eu` or `us` pins processing to that region for data residency. Unset uses the
# global endpoint, which routes to whichever region is closest — fine
# technically, and the thing to set before signing a data-processing agreement
# that names a jurisdiction.
GCP_VISION_REGION=

# Hard cap on a single annotate call. Vision answers a phone screenshot in
# 400-900ms; past six seconds it is a network problem, not a slow read, and the
# resident is watching an upload bar. Default 6000.
EVIDENCE_VISION_TIMEOUT_MS=

# Calls per Gregorian month before reads stop and log loudly. Not a budget — a
# breaker, so that a bug which retries in a loop costs a dashboard warning
# rather than a bill. Free tier is 1,000 units/month. Default 5000.
EVIDENCE_VISION_MONTHLY_CAP=

# Sandbox merchants, per provider. A gateway entry set to `mode: SANDBOX` uses
# these for EVERY hostel, and the result is flagged `sandbox: true` so no screen
# can present a test merchant as a live one. Sandbox entries are hidden from
# residents entirely in production.
#
# eSewa needs nothing here: its test merchant (EPAYTEST) is published in eSewa's
# own developer documentation and is the built-in default. Set these two only to
# override it.
ESEWA_SANDBOX_MERCHANT_CODE=
ESEWA_SANDBOX_SECRET=
#
# Khalti has no shared test merchant — register at https://dev.khalti.com/ and
# copy the secret key from that dashboard. Khalti identifies the merchant by key
# alone, so the merchant code is a placeholder it never sends.
KHALTI_SANDBOX_MERCHANT_CODE=khalti-sandbox
KHALTI_SANDBOX_SECRET=
#
# Fonepay publishes no universal sandbox merchant: the code and signing secret
# are issued per merchant by the acquiring bank, not self-service from Fonepay.
FONEPAY_SANDBOX_MERCHANT_CODE=
FONEPAY_SANDBOX_SECRET=
# Optional per provider; falls back to <PROVIDER>_SANDBOX_SECRET where one key
# signs both ways.
# ESEWA_SANDBOX_WEBHOOK_SECRET=
# KHALTI_SANDBOX_WEBHOOK_SECRET=
# FONEPAY_SANDBOX_WEBHOOK_SECRET=

# --- QuestionCall integration (Phase 5, optional) ---
# The study row's label, link and switch are site config (Website Config →
# Site Content → QuestionCall). The webhook secret authenticates QuestionCall's
# "this student signed up" callback; without it that endpoint answers 503
# rather than trusting anyone.
QUESTIONCALL_WEBHOOK_SECRET=
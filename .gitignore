# Dependencies
node_modules/
website_mock_desing_for_portals

# Next.js / React build output
.next/
out/
build/
dist/

ui_inspiration_folder

# Logs
*.log
# Crash dumps Git Bash leaves beside the repo.
*.stackdump
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Tool caches
.turbo/
.cache/
coverage/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Agent-local hook config. These can contain machine-specific paths.
.codex/
.claude/

# Keep portable Graphify context tracked for agents.
!graphify-out/
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
!graphify-out/graph.html

# Ignore local/cache Graphify data.
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/manifest.json

# Runtime-generated activation QR images (local fallback when R2 is unconfigured).
apps/web/public/uploads/activation-qr/

# Tesseract language models that land beside the process as a download.
#
# `apps/web/tessdata/eng.traineddata` is deliberately NOT ignored: it is the
# model the recogniser is pointed at, and it has to be in the deployment or the
# read hangs. See apps/web/src/modules/finance/evidence-ocr.ts.
*.traineddata
!apps/web/tessdata/*.traineddata

# The evidence golden set (evidence pipeline, phase 0).
#
# The manifest is the artefact worth versioning — it is the hand-written ground
# truth, and a change to it is a change to what "correct" means. The images are
# not: the synthetic ones are reproducible with `npm run web:evidence:fixtures`,
# and the real ones are residents' payment screenshots, which must never enter
# git history. Keep those in a private R2 prefix.
fixtures/evidence-golden/*
!fixtures/evidence-golden/manifest.json
